{
  "name": "n8n-nodes-fiftyw-media",
  "version": "3.1.5",
  "description": "Erase image watermarks and video text, and resolve share links using native 550W OAuth REST APIs",
  "homepage": "https://eraser.550wai.com/agent/",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "oauth2",
    "subtitle-removal",
    "watermark-removal"
  ],
  "author": {
    "name": "sunshinehu",
    "email": "x12363@126.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunshinehu/n8n-nodes-550w-ai.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "test": "npm run build && node --test test/*.test.js",
    "lint": "n8n-node lint",
    "dev": "n8n-node dev"
  },
  "files": [
    "dist/credentials/FiftyWOAuth2Api.credentials.js",
    "dist/nodes/FiftyW/FiftyW.node.js",
    "dist/nodes/FiftyW/icon.svg",
    "examples/*.json",
    "docs/server-setup.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/FiftyWOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FiftyW/FiftyW.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.49.1",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
